  Node2 [id="Node000002",label="BMPHeader",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structBMPHeader.html",tooltip="Contains file header information for a BMP file."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" infoHeader",fontcolor="grey" ];
